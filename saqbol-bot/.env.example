# Токен бота: Telegram -> @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=

# Ключ Gemini (бесплатно, без карты): https://aistudio.google.com/apikey
# Без ключа бот работает только на правилах (без ИИ)
GEMINI_API_KEY=

# Необязательно. Модель подешевле: gemini-3.5-flash-lite
# SAQBOL_MODEL=gemini-3.8-flash

# Необязательно. Переключение на Claude:
# SAQBOL_PROVIDER=claude
# ANTHROPIC_API_KEY=

# Необязательно. Кому пересылать заявки со страницы тарифов: напишите боту /myid и впишите число
# SAQBOL_ADMIN_CHAT=
