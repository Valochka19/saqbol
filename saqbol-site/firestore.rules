rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Сводка для сайта: только агрегаты и замаскированные номера.
    match /public/{doc} {
      allow read: if true;
    }
    // Очередь веб-проверок: сайт может только положить текст. Прочитать чужой запрос нельзя,
    // бот удаляет его сразу после обработки.
    match /web_requests/{id} {
      allow create: if request.resource.data.created_at == request.time && (
        // проверка сообщения
        (request.resource.data.keys().hasOnly(['text', 'created_at'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000)
        // проверка скриншота: уменьшенный JPEG в base64 (документ Firestore ограничен 1 МБ)
        || (request.resource.data.keys().hasOnly(['image', 'created_at'])
          && request.resource.data.image is string
          && request.resource.data.image.size() > 100 && request.resource.data.image.size() <= 950000)
        // проверка получателя: номер, карта, ссылка
        || (request.resource.data.keys().hasOnly(['lookup', 'created_at'])
          && request.resource.data.lookup is string
          && request.resource.data.lookup.size() > 0 && request.resource.data.lookup.size() <= 120)
        // жалоба из приложения после звонка: номер и постоянный код установки
        || (request.resource.data.keys().hasOnly(['report', 'created_at'])
          && request.resource.data.report is map
          && request.resource.data.report.keys().hasOnly(['number', 'device'])
          && request.resource.data.report.number is string && request.resource.data.report.number.size() <= 40
          && request.resource.data.report.device is string
          && request.resource.data.report.device.size() >= 16 && request.resource.data.report.device.size() <= 64)
        // заявка на сертификат: имя и результаты тренажёра
        || (request.resource.data.keys().hasOnly(['cert', 'created_at'])
          && request.resource.data.cert is map
          && request.resource.data.cert.keys().hasOnly(['name', 'cases', 'hard', 'calls'])
          && request.resource.data.cert.name is string && request.resource.data.cert.name.size() <= 60
          && request.resource.data.cert.cases is int && request.resource.data.cert.hard is int
          && request.resource.data.cert.calls is int)
        // ход в тренажёре «Разговор с мошенником»
        || (request.resource.data.keys().hasOnly(['sim', 'created_at'])
          && request.resource.data.sim is map
          && request.resource.data.sim.keys().hasOnly(['scenario', 'history', 'hangup'])
          && request.resource.data.sim.scenario in ['bank', 'police', 'buyer']
          && request.resource.data.sim.history is list && request.resource.data.sim.history.size() <= 20
          && request.resource.data.sim.hangup is bool)
      );
    }
    // Ответ читается только по точному id (он случайный и известен лишь отправителю). Списком — нельзя.
    match /web_results/{id} {
      allow get: if true;
    }
    // Заявки с страницы тарифов: только создание, читает их бот
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasOnly(['plan', 'org', 'contact', 'note', 'created_at'])
                    && request.resource.data.created_at == request.time
                    && request.resource.data.plan in ['team', 'bank']
                    && request.resource.data.org is string && request.resource.data.org.size() >= 2 && request.resource.data.org.size() <= 80
                    && request.resource.data.contact is string && request.resource.data.contact.size() >= 5 && request.resource.data.contact.size() <= 80
                    && request.resource.data.note is string && request.resource.data.note.size() <= 400;
    }
    // Сертификат проверяется по точному номеру (из QR-кода). Списком получить сертификаты нельзя.
    match /certificates/{id} {
      allow get: if true;
    }
    // Всё остальное (индикаторы, жалобы, статистика) доступно только боту через Admin SDK.
  }
}
